# Copy this file to scripts/gcp/.env and edit values before submitting jobs.

# Core GCP settings.
PROJECT_ID=your-gcp-project-id
REGION=us-central1
ZONE=us-central1-a

# Artifact Registry image settings.
AR_REPOSITORY=verl-rl
IMAGE_NAME=verl-gcp
IMAGE_TAG=runner
DOCKER_PLATFORM=linux/amd64
# Optional: leave blank to derive from REGION/PROJECT_ID/AR_REPOSITORY/IMAGE_NAME/IMAGE_TAG.
IMAGE_URI=

# Vertex AI CustomJob settings.
VERTEX_JOB_NAME=verl-rl
VERTEX_MACHINE_TYPE=g2-standard-16
VERTEX_ACCELERATOR_TYPE=NVIDIA_L4
VERTEX_ACCELERATOR_COUNT=1
VERTEX_TIMEOUT_SECONDS=7200
# Optional: service account email with Artifact Registry read, GCS read/write, and Vertex AI permissions.
VERTEX_SERVICE_ACCOUNT=
# Optional: gs:// bucket/prefix for Vertex base output directory.
VERTEX_OUTPUT_URI=

# Training settings passed into the container.
N_GPUS=1
MODEL_PATH=Qwen/Qwen2.5-0.5B-Instruct
# Choose grpo or ppo. PPO maps to ADV_ESTIMATOR=gae unless overridden.
RL_ALGORITHM=grpo
ADV_ESTIMATOR=
CRITIC_MODEL_PATH=Qwen/Qwen2.5-0.5B-Instruct
EXP_NAME=verl-rl
PROJECT_NAME=verl_gcp
TOTAL_TRAINING_STEPS=2
# Leave TOTAL_TRAINING_STEPS empty and set TOTAL_EPOCHS for epoch-based runs.
TOTAL_EPOCHS=
TRAIN_BATCH_SIZE=8
DATALOADER_NUM_WORKERS=0
TRAIN_MAX_SAMPLES=-1
VAL_MAX_SAMPLES=16
PPO_MINI_BATCH_SIZE=4
PPO_MICRO_BATCH_SIZE_PER_GPU=1
CRITIC_PPO_MICRO_BATCH_SIZE_PER_GPU=1
ROLLOUT_N=2
MAX_PROMPT_LENGTH=512
MAX_RESPONSE_LENGTH=512
# Conservative single-L4 smoke defaults. Raise these for larger production runs.
MAX_MODEL_LEN=1024
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=8192
ROLLOUT_AGENT_NUM_WORKERS=1
ROLLOUT_ENFORCE_EAGER=True
ROLLOUT_ENABLE_CHUNKED_PREFILL=False
GPU_MEMORY_UTILIZATION=0.35
ACTOR_LR=1e-6
CRITIC_LR=1e-5
KL_COEF=0.001
KL_LOSS_COEF=0.001
SAVE_FREQ=1
TEST_FREQ=1
TRAINER_LOGGER='["console","tensorboard","file"]'
# Optional extra Hydra overrides. Separate multiple overrides with semicolons.
# Example:
# EXTRA_HYDRA_ARGS='trainer.total_epochs=3;actor_rollout_ref.rollout.n=4'
EXTRA_HYDRA_ARGS=

# Metrics output. TensorBoard event files and JSONL metrics are written under
# METRICS_DIR. launch_vertex_experiment.sh creates or reuses a managed Vertex AI
# TensorBoard before submission by default, then prints a per-job experiment URL
# you can open while training is still running.
METRICS_DIR=
METRICS_SYNC_INTERVAL_SECONDS=60
ENABLE_VERTEX_TENSORBOARD=1
VERTEX_TENSORBOARD_DISPLAY_NAME=verl-rl
VERTEX_TENSORBOARD_RESOURCE_NAME=
VERTEX_TENSORBOARD_EXPERIMENT_NAME=
TENSORBOARD_FINAL_UPLOAD_TIMEOUT_SECONDS=120
TENSORBOARD_UPLOADER_ROLE_ID=vertexTensorboardUploader

# Required: existing training and validation parquet files.
# Use gs:// paths for serverless jobs; the container stages them to local disk.
# Multiple parquet shards can be comma-separated.
TRAIN_FILES=gs://YOUR_BUCKET/datasets/gsm8k/train.parquet
VAL_FILES=gs://YOUR_BUCKET/datasets/gsm8k/test.parquet

# Required: checkpoint object-storage destination.
# The container writes checkpoints locally and syncs them here periodically and on exit.
GCS_CHECKPOINT_URI=gs://YOUR_BUCKET/checkpoints/verl-rl
CHECKPOINT_SYNC_INTERVAL_SECONDS=300

# Optional: copy training metrics to this GCS prefix periodically and on exit.
# launch_vertex_experiment.sh resolves this to gs://$GCS_BUCKET/metrics/$EXP_NAME.
GCS_METRICS_URI=

# Optional: copy /workspace/outputs to this GCS prefix at the end of the job.
GCS_OUTPUT_URI=
